{
  "name": "waybound",
  "version": "0.4.0-alpha.1",
  "description": "A unified, multi-provider routing and geospatial engine for TypeScript.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "imports": {
    "#core": "./src/core/index.ts",
    "#types": "./src/types/index.ts",
    "#http": "./src/http/index.ts",
    "#providers": "./src/providers/index.ts",
    "#providers/*": "./src/providers/*/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.mts",
    "prepublishOnly": "npm test && npm run build",
    "yalc:push": "npm run build && yalc push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivohamse/waybound.git"
  },
  "bugs": {
    "url": "https://github.com/ivohamse/waybound/issues"
  },
  "homepage": "https://github.com/ivohamse/waybound#readme",
  "keywords": [
    "routing",
    "geojson",
    "openrouteservice",
    "graphhopper",
    "maps",
    "hike",
    "bike"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "devDependencies": {
    "@types/geojson": "latest",
    "@types/node": "^26.5.0",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "esbuild": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
